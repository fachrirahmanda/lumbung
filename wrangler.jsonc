{
  // Lumbung: files kept in Google Drive, with its own sign-in and file list.
  // Separate from the Silpasala Worker (its own D1 database and secrets).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumbung",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumbung",
      "database_id": "fb1a0efd-fd10-48a3-9f13-e747440b0ae5",
      "migrations_dir": "migrations"
    }
  ]
}
