# Copy to .dev.vars for local development. Never commit .dev.vars.
# The superadmin's Google account. Only this account can connect Drive and manage members.
SUPERADMIN_EMAIL=
# The same Google OAuth client as the app that created the files (drive.file scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Google Drive token. Any long random string.
SETTINGS_KEY=
